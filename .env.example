# Copy to .env and edit. Never commit .env.

# --- PostgreSQL (used by docker-compose.yml and the application) ---
POSTGRES_USER=moleculetrace
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=moleculetrace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection string used by psycopg, FastAPI and the ML scripts.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Separate database used by pytest so tests never touch your working data.
TEST_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}_test

# --- Backend ---
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=info

# --- Frontend ---
STREAMLIT_PORT=8501
API_BASE_URL=http://127.0.0.1:8000

# --- ML ---
RANDOM_SEED=42
MODEL_ARTIFACT_DIR=project/ml/models
